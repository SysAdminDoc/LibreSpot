<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Self-contained publish embeds the runtime; rebuild against the newest
         patch level so servicing CVE fixes reach shipped artifacts. See RD-32 /
         schemas/dependency-health-allowlist.json dotnetRuntimeFloor. -->
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
    <AssemblyName>LibreSpot.Cli</AssemblyName>
    <Version>4.1.2</Version>
    <AssemblyVersion>4.1.2.0</AssemblyVersion>
    <FileVersion>4.1.2.0</FileVersion>
    <InformationalVersion>4.1.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LibreSpot.Core\LibreSpot.Core.csproj" />
  </ItemGroup>
</Project>
