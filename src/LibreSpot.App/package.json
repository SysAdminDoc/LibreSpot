{
  "name": "@librespot/live-customization-engine",
  "version": "4.1.2",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "bundle": "node scripts/build.mjs && pwsh -NoProfile -File scripts/package.ps1",
    "catalog:refresh": "node scripts/catalog-tool.mjs refresh",
    "catalog:truth": "node scripts/catalog-tool.mjs truth",
    "lint": "eslint src tests scripts vitest.config.ts",
    "test": "vitest run --pool=forks --maxWorkers=1 --fileParallelism=false",
    "check": "pnpm run lint && pnpm run catalog:truth && pnpm run build && pnpm run bundle && pnpm run test"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "happy-dom": "20.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "spicetify-creator": "1.0.17",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.17.1"
}
