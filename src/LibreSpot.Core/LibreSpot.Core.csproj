<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WPF-free class library holding non-UI logic shared by the WPF desktop and
         the fleet CLI. Targets net10.0-windows (Win32/registry/WMI APIs) but does
         NOT set UseWPF, so it is a valid Stryker.NET mutation-testing target where
         the UseWPF desktop project is not. See ROADMAP RD-35 / Roadmap_Blocked
         "Add Stryker.NET mutation testing". -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
    <AssemblyName>LibreSpot.Core</AssemblyName>
    <RootNamespace>LibreSpot.Desktop</RootNamespace>
    <Version>4.1.2</Version>
    <InformationalVersion>4.1.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LibreSpot.Desktop.Tests" />
    <InternalsVisibleTo Include="LibreSpot.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Schemas loaded by Core services via Assembly.GetExecutingAssembly();
         LogicalNames preserve the original LibreSpot.Desktop.Schemas.* manifest
         names so the moved code resolves them unchanged. -->
    <EmbeddedResource Include="..\..\schemas\operation-token-types.json" LogicalName="LibreSpot.Desktop.Schemas.operation-token-types.json" />
    <EmbeddedResource Include="..\..\schemas\run-receipt-format.json" LogicalName="LibreSpot.Desktop.Schemas.run-receipt-format.json" />
    <EmbeddedResource Include="..\..\schemas\community-assets.json" LogicalName="LibreSpot.Desktop.Schemas.community-assets.json" />
    <EmbeddedResource Include="..\..\schemas\librespot-customization.json" LogicalName="LibreSpot.Desktop.Schemas.librespot-customization.json" />
    <EmbeddedResource Include="..\LibreSpot.Desktop\Backend\LibreSpot.Backend.ps1" LogicalName="LibreSpot.Desktop.Backend.LibreSpot.Backend.ps1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Localization ownership (RD-35). The resx/Designer physical files remain in
         the desktop Properties folder (so the Sync-Localization tool and the
         localization gate keep their paths) but are compiled/embedded HERE. Core's
         RootNamespace is LibreSpot.Desktop, so linking as Properties\Strings.resx
         reproduces the exact LibreSpot.Desktop.Properties.Strings manifest name and
         culture satellites the ResourceManager expects. -->
    <Compile Include="..\LibreSpot.Desktop\Properties\Strings.Designer.cs" Link="Properties\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Include="..\LibreSpot.Desktop\Properties\Strings.resx" Link="Properties\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Include="..\LibreSpot.Desktop\Properties\Strings.en.resx" Link="Properties\Strings.en.resx" />
    <EmbeddedResource Include="..\LibreSpot.Desktop\Properties\Strings.es.resx" Link="Properties\Strings.es.resx" />
    <EmbeddedResource Include="..\LibreSpot.Desktop\Properties\Strings.pt-BR.resx" Link="Properties\Strings.pt-BR.resx" />
    <EmbeddedResource Include="..\LibreSpot.Desktop\Properties\Strings.ru.resx" Link="Properties\Strings.ru.resx" />
    <EmbeddedResource Include="..\LibreSpot.Desktop\Properties\Strings.zh-Hans.resx" Link="Properties\Strings.zh-Hans.resx" />
  </ItemGroup>
</Project>
