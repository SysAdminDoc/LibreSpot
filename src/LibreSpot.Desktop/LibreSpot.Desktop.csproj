<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Self-contained publish embeds the runtime, so it only receives .NET
         servicing CVE fixes when rebuilt against the newest patch level the
         build SDK ships. See RD-32 / schemas/dependency-health-allowlist.json
         dotnetRuntimeFloor. -->
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
    <AssemblyName>LibreSpot</AssemblyName>
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>4.0.0-preview.28</Version>
    <AssemblyVersion>4.0.0.23</AssemblyVersion>
    <FileVersion>4.0.0.23</FileVersion>
    <InformationalVersion>4.0.0-preview.28</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\icon.ico" Link="Assets\LibreSpot.ico" />
    <Resource Include="Assets\LibreSpot-256.png" />
    <EmbeddedResource Include="Backend\LibreSpot.Backend.ps1" LogicalName="LibreSpot.Desktop.Backend.LibreSpot.Backend.ps1" />
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="LibreSpot.Desktop.Docs.CHANGELOG.md" />
    <EmbeddedResource Include="..\..\schemas\community-assets.json" LogicalName="LibreSpot.Desktop.Schemas.community-assets.json" />
    <EmbeddedResource Include="..\..\schemas\operation-token-types.json" LogicalName="LibreSpot.Desktop.Schemas.operation-token-types.json" />
    <EmbeddedResource Include="..\..\schemas\run-receipt-format.json" LogicalName="LibreSpot.Desktop.Schemas.run-receipt-format.json" />
    <!-- Localization resources are OWNED by LibreSpot.Core (RD-35): Core embeds
         Strings.resx + the locale satellites and compiles Strings.Designer.cs, so
         the resx/Designer physical files stay here but are excluded from this
         project's default globbing to avoid a duplicate Strings type. -->
    <EmbeddedResource Remove="Properties\Strings.resx" />
    <EmbeddedResource Remove="Properties\Strings.*.resx" />
    <Compile Remove="Properties\Strings.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- v4 shell controls use the active lepo.co package identity: WPF-UI.
         Do not switch to the older similarly named Wpf.Ui package ID. -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LibreSpot.Core\LibreSpot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\RecommendedWorkspaceView.xaml.cs">
      <DependentUpon>RecommendedWorkspaceView.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\CustomWorkspaceView.xaml.cs">
      <DependentUpon>CustomWorkspaceView.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\CustomInstallSection.xaml.cs">
      <DependentUpon>CustomInstallSection.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\CustomAppearanceSection.xaml.cs">
      <DependentUpon>CustomAppearanceSection.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\CustomBehaviorSection.xaml.cs">
      <DependentUpon>CustomBehaviorSection.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\CustomAdvancedSection.xaml.cs">
      <DependentUpon>CustomAdvancedSection.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\CustomPatchesSection.xaml.cs">
      <DependentUpon>CustomPatchesSection.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\CustomBuiltInExtensionsSection.xaml.cs">
      <DependentUpon>CustomBuiltInExtensionsSection.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\CustomAppsSection.xaml.cs">
      <DependentUpon>CustomAppsSection.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\CustomProfileSummarySection.xaml.cs">
      <DependentUpon>CustomProfileSummarySection.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\MaintenanceWorkspaceView.xaml.cs">
      <DependentUpon>MaintenanceWorkspaceView.xaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
