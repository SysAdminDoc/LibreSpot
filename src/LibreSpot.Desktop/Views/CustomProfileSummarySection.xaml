<UserControl x:Class="LibreSpot.Desktop.Views.CustomProfileSummarySection"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:controls="clr-namespace:LibreSpot.Desktop.Controls"
 xmlns:services="clr-namespace:LibreSpot.Desktop.Services"
 mc:Ignorable="d"
 UseLayoutRounding="True"
 SnapsToDevicePixels="True">
                <Border Style="{StaticResource MinimalSectionStyle}">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock x:Name="ProfileQaSurface"
                                     Text="{services:Loc Ui_LocalProfiles}"
                                     Style="{StaticResource LabelTextStyle}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" />
                          <Button Grid.Column="1"
                                  Content="{services:Loc Ui_Refresh}"
                                  Height="30"
                                  MinWidth="82"
                                  Padding="12,0"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Command="{Binding RefreshProfilesCommand}"
                                  AutomationProperties.Name="{services:Loc Ui_RefreshLocalProfiles}"
                                  AutomationProperties.HelpText="{services:Loc Ui_ReloadsBundledTemplatesAndLocalProfileFilesFrom}" />
                        </Grid>
                        <TextBlock Text="{services:Loc Ui_SaveNamedPresetsPreviewTemplatesAndImportShared}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,8,0,12" />
                        <Grid>
                        <ListBox x:Name="LocalProfilesList"
                                 ItemsSource="{Binding LocalProfiles}"
                                 SelectedItem="{Binding SelectedLocalProfile, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource LocalProfileTemplate}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 PreviewMouseWheel="NestedScrollRegion_OnPreviewMouseWheel"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 KeyboardNavigation.DirectionalNavigation="Contained"
                                 AutomationProperties.Name="{services:Loc Ui_LocalProfiles}"
                                 AutomationProperties.HelpText="{services:Loc Ui_NamedLibreSpotProfilesAndBundledTemplates}">
                          <ListBox.Style>
                            <Style TargetType="ListBox">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLocalProfiles}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ListBox.Style>
                          <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListBoxItemStyle}">
                              <Setter Property="Margin" Value="0" />
                              <Setter Property="Padding" Value="0" />
                              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                              <Setter Property="VerticalContentAlignment" Value="Stretch" />
                              <Setter Property="Background" Value="Transparent" />
                              <Setter Property="BorderBrush" Value="Transparent" />
                              <Setter Property="BorderThickness" Value="2" />
                              <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                              <Setter Property="AutomationProperties.HelpText" Value="{Binding AutomationHelpText}" />
                              <Style.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                  <Setter Property="BorderBrush" Value="{DynamicResource AccentRingBrush}" />
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </ListBox.ItemContainerStyle>
                        </ListBox>
                        </Grid>

                        <Border Margin="0,0,0,12">
                          <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SubtleCardStyle}">
                              <Setter Property="Padding" Value="14" />
                              <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLocalProfiles}" Value="False">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <StackPanel>
                            <TextBlock Text="{services:Loc Ui_NoProfilesAvailable}"
                                       Style="{StaticResource EmptyStateTitleTextStyle}" />
                            <TextBlock Text="{services:Loc Ui_SaveTheCurrentCustomSelectionsOrImportA}"
                                       Style="{StaticResource EmptyStateBodyTextStyle}"
                                       Margin="0,6,0,0" />
                          </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SubtleCardStyle}"
                                Background="{DynamicResource Surface3Brush}"
                                BorderBrush="{DynamicResource StrokeBrush}"
                                Padding="14"
                                Margin="0,2,0,12">
                          <StackPanel>
                            <TextBlock Text="{services:Loc Ui_SelectedProfile}"
                                       Style="{StaticResource LabelTextStyle}" />
                            <TextBlock Text="{Binding SelectedLocalProfileTitle}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,4" />
                            <TextBlock Text="{Binding SelectedLocalProfileDetail}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="{Binding ProfileSelectionHint}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,8,0,0" />
                          </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Surface1Brush}"
                                BorderBrush="{DynamicResource StrokeSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusLg}"
                                Padding="12"
                                Margin="0,0,0,12"
                                AutomationProperties.Name="{services:Loc Ui_ProfileOperationStatus}"
                                AutomationProperties.HelpText="{services:Loc Ui_AnnouncesTheLatestProfileActionResult}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="4"
                                    CornerRadius="{StaticResource RadiusXs}"
                                    Background="{DynamicResource AccentBrush}"
                                    Margin="0,2,10,0"
                                    VerticalAlignment="Stretch" />
                            <controls:LiveRegionContentControl Grid.Column="1"
                                                               Content="{Binding ProfileOperationStatus}"
                                                               AutomationProperties.HelpText="{services:Loc Ui_ProfileOperationStatus}">
                              <controls:LiveRegionContentControl.ContentTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding}"
                                             Style="{StaticResource CaptionTextStyle}"
                                             Foreground="{DynamicResource MutedTextBrush}" />
                                </DataTemplate>
                              </controls:LiveRegionContentControl.ContentTemplate>
                            </controls:LiveRegionContentControl>
                          </Grid>
                        </Border>

                        <Border Background="{DynamicResource Surface1Brush}"
                                BorderBrush="{DynamicResource StrokeSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusLg}"
                                Padding="12"
                                Margin="0,0,0,12"
                                AutomationProperties.Name="{services:Loc Ui_ProfileShareCard}"
                                AutomationProperties.HelpText="{services:Loc Ui_ShowsAnInertShareLinkQRCodeAnd}">
                          <StackPanel>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Width="124"
                                      Height="124"
                                      Background="{DynamicResource Surface3Brush}"
                                      BorderBrush="{DynamicResource StrokeSoftBrush}"
                                      BorderThickness="1"
                                      CornerRadius="{StaticResource RadiusMd}"
                                      Padding="8"
                                      Margin="0,0,12,0">
                                <Grid>
                                  <Image Source="{Binding SelectedProfileQrImage}"
                                         Stretch="Uniform"
                                         AutomationProperties.Name="{services:Loc Ui_SelectedProfileQRCode}"
                                         Visibility="{Binding HasSelectedProfileQrImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                  <TextBlock Text="{services:Loc Ui_NoQR}"
                                             Foreground="{DynamicResource MutedTextBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding HasSelectedProfileQrImage}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                </Grid>
                              </Border>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="{services:Loc Ui_ShareCard}"
                                           Style="{StaticResource LabelTextStyle}"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding SelectedProfileShareStatus}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,8" />
                                <TextBox Text="{Binding SelectedProfileShareUri, Mode=OneWay}"
                                         Style="{StaticResource TextBoxStylePremium}"
                                         IsReadOnly="True"
                                         Height="36"
                                         TextWrapping="NoWrap"
                                         AutomationProperties.Name="{services:Loc Ui_SelectedProfileShareLink}"
                                         AutomationProperties.HelpText="{services:Loc Ui_InertLibrespotProfileLinkForPreviewOnlyImport}" />
                              </StackPanel>
                            </Grid>

                            <TextBlock Text="{services:Loc Ui_CompareToRecommended}"
                                       Style="{StaticResource LabelTextStyle}"
                                       Margin="0,12,0,6" />
                            <TextBlock Text="{Binding SelectedProfileComparisonText}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" />
                            <UniformGrid Columns="2" Margin="0,12,0,0">
                              <Button Content="{services:Loc Ui_CopyLink}"
                                      Height="34"
                                      Margin="0,0,6,0"
                                      Style="{StaticResource SecondaryButtonStyle}"
                                      Command="{Binding CopyProfileShareUriCommand}"
                                      AutomationProperties.Name="{services:Loc Ui_CopySelectedProfileShareLink}" />
                              <Button Content="{services:Loc Ui_CopyCompare}"
                                      Height="34"
                                      Margin="6,0,0,0"
                                      Style="{StaticResource SecondaryButtonStyle}"
                                      Command="{Binding CopyProfileComparisonCommand}"
                                      AutomationProperties.Name="{services:Loc Ui_CopySelectedProfileComparison}" />
                            </UniformGrid>
                          </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Button Content="{services:Loc Ui_Preview}"
                                  Height="34"
                                  Margin="0,0,6,0"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Command="{Binding PreviewSelectedProfileCommand}"
                                  AutomationProperties.Name="{services:Loc Ui_PreviewSelectedProfile}"
                                  AutomationProperties.HelpText="{services:Loc Ui_LoadsTheSelectedProfileIntoTheCustomEditor}" />
                          <Button Grid.Column="1"
                                  Content="{services:Loc Ui_SetActive}"
                                  Height="34"
                                  Margin="6,0,0,0"
                                  Style="{StaticResource PrimaryButtonStyle}"
                                  Command="{Binding ApplySelectedProfileCommand}"
                                  AutomationProperties.AutomationId="ProfileSetActiveButton"
                                  AutomationProperties.Name="{services:Loc Ui_SetSelectedProfileActive}"
                                  AutomationProperties.HelpText="{services:Loc Ui_ConfirmsAndWritesTheSelectedProfileToConfig}" />
                        </Grid>

                        <TextBlock Text="{services:Loc Ui_ProfileDetails}"
                                   Style="{StaticResource LabelTextStyle}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding ProfileEditorHint}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,6,0,10" />
                        <TextBlock Text="{services:Loc Ui_ProfileName}"
                                   Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding ProfileNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStylePremium}"
                                 Height="38"
                                 Margin="0,6,0,10"
                                 AutomationProperties.Name="{services:Loc Ui_ProfileName}"
                                 AutomationProperties.HelpText="{services:Loc Ui_NameUsedWhenSavingOrRenamingALocal}" />
                        <TextBlock Text="{services:Loc Ui_Notes}"
                                   Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding ProfileDescriptionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxStylePremium}"
                                 Height="62"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Margin="0,6,0,12"
                                 AutomationProperties.Name="{services:Loc Ui_ProfileNotes}"
                                 AutomationProperties.HelpText="{services:Loc Ui_ShortDescriptionStoredWithTheLocalProfile}" />

                        <TextBlock Text="{services:Loc Ui_ManageProfile}"
                                   Style="{StaticResource LabelTextStyle}"
                                   Margin="0,0,0,8" />
                        <UniformGrid Columns="2" Margin="0,0,0,4">
                          <Button Content="{services:Loc Ui_SaveCurrent}"
                                  Height="34"
                                  Margin="0,0,6,8"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Command="{Binding CreateProfileCommand}"
                                  AutomationProperties.Name="{services:Loc Ui_SaveCurrentSelectionsAsProfile}"
                                  AutomationProperties.HelpText="{services:Loc Ui_SavesTheCurrentCustomSelectionsAsANew}" />
                          <Button Content="{services:Loc Ui_Duplicate}"
                                  Height="34"
                                  Margin="6,0,0,8"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Command="{Binding DuplicateProfileCommand}"
                                  AutomationProperties.Name="{services:Loc Ui_DuplicateSelectedProfile}"
                                  AutomationProperties.HelpText="{services:Loc Ui_CreatesANewLocalCopyOfTheSelected}" />
                          <Button Content="{services:Loc Ui_Rename}"
                                  Height="34"
                                  Margin="0,0,6,8"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Command="{Binding RenameProfileCommand}"
                                  AutomationProperties.Name="{services:Loc Ui_RenameSelectedProfile}"
                                  AutomationProperties.HelpText="{services:Loc Ui_RenamesTheSelectedLocalProfileUsingTheProfile}" />
                          <Button Content="{services:Loc Ui_Import}"
                                  Height="34"
                                  Margin="6,0,0,8"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Command="{Binding ImportProfileCommand}"
                                  AutomationProperties.Name="{services:Loc Ui_ImportLibreSpotProfile}"
                                  AutomationProperties.HelpText="{services:Loc Ui_OpensALibrespotProfileAsAnInertPreview}" />
                          <Button Content="{services:Loc Ui_Export}"
                                  Height="34"
                                  Margin="0,0,6,8"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Command="{Binding ExportProfileCommand}"
                                  AutomationProperties.Name="{services:Loc Ui_ExportSelectedProfile}"
                                  AutomationProperties.HelpText="{services:Loc Ui_ExportsTheSelectedProfileAsASafeLibrespot}" />
                          <Button Content="{services:Loc Ui_Delete}"
                                  Height="34"
                                  Margin="6,0,0,8"
                                  Style="{StaticResource DestructiveButtonStyle}"
                                  Command="{Binding DeleteProfileCommand}"
                                  AutomationProperties.Name="{services:Loc Ui_DeleteSelectedLocalProfile}"
                                  AutomationProperties.HelpText="{services:Loc Ui_ConfirmsAndRemovesTheSelectedLocalProfileFile}" />
                        </UniformGrid>

                        <Border Background="{DynamicResource Surface1Brush}"
                                BorderBrush="{DynamicResource StrokeSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusLg}"
                                Padding="12"
                                Margin="0,10,0,12"
                                AutomationProperties.Name="{services:Loc Ui_CommunityAndChangelog}">
                          <StackPanel>
                            <TextBlock Text="{services:Loc Ui_ChangelogPreview}"
                                       Style="{StaticResource LabelTextStyle}"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <ItemsControl ItemsSource="{Binding ChangelogHighlights}"
                                          Margin="0,8,0,10">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding}"
                                             Style="{StaticResource CaptionTextStyle}"
                                             TextWrapping="Wrap"
                                             Margin="0,0,0,6" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{services:Loc Ui_CommunityLinks}"
                                       Style="{StaticResource LabelTextStyle}"
                                       Margin="0,2,0,8" />
                            <UniformGrid Columns="3">
                              <Button Content="{services:Loc Ui_Repo}"
                                      Height="32"
                                      Margin="0,0,6,0"
                                      Style="{StaticResource SecondaryButtonStyle}"
                                      Command="{Binding OpenRepositoryCommand}"
                                      AutomationProperties.Name="{services:Loc Ui_OpenLibreSpotRepository}" />
                              <Button Content="{services:Loc ExtensionsLabel}"
                                      Height="32"
                                      Margin="3,0,3,0"
                                      Style="{StaticResource SecondaryButtonStyle}"
                                      Command="{Binding OpenSpicetifyCommunityCommand}"
                                      AutomationProperties.Name="{services:Loc Ui_OpenSpicetifyExtensionDocs}" />
                              <Button Content="{services:Loc Ui_Themes}"
                                      Height="32"
                                      Margin="6,0,0,0"
                                      Style="{StaticResource SecondaryButtonStyle}"
                                      Command="{Binding OpenThemeCatalogCommand}"
                                      AutomationProperties.Name="{services:Loc Ui_OpenSpicetifyThemeCatalog}" />
                            </UniformGrid>
                          </StackPanel>
                        </Border>

                        <Border Height="1"
                                Background="{DynamicResource StrokeSoftBrush}"
                                Margin="0,12,0,16" />

                        <TextBlock Text="{services:Loc ProfileSummaryLabel}"
                                   Style="{StaticResource LabelTextStyle}"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding CustomProfileTitle}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="18"
                                   Margin="0,8,0,4" />
                        <TextBlock Text="{Binding CustomProfileDetail}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{DynamicResource TextBrush}" />

                        <Border Height="1"
                                Background="{DynamicResource StrokeSoftBrush}"
                                Margin="0,16,0,16" />

                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="106" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>

                          <TextBlock Text="{services:Loc InstallPostureLabel}"
                                     Style="{StaticResource LabelTextStyle}"
                                     Margin="0,2,12,0" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding InstallPostureLabel}"
                                     Foreground="{DynamicResource TextBrush}"
                                     FontWeight="SemiBold"
                                     FontSize="13"
                                     TextWrapping="Wrap" />

                          <TextBlock Grid.Row="1"
                                     Text="{services:Loc ProfileChangesLabel}"
                                     Style="{StaticResource LabelTextStyle}"
                                     Margin="0,12,12,0" />
                          <TextBlock Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding CustomChangeCountLabel}"
                                     Foreground="{DynamicResource TextBrush}"
                                     FontWeight="SemiBold"
                                     FontSize="13"
                                     TextWrapping="Wrap"
                                     Margin="0,12,0,0" />

                          <TextBlock Grid.Row="2"
                                     Text="{services:Loc ExtensionsLabel}"
                                     Style="{StaticResource LabelTextStyle}"
                                     Margin="0,12,12,0" />
                          <TextBlock Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding SelectedExtensionCountLabel}"
                                     Foreground="{DynamicResource TextBrush}"
                                     FontWeight="SemiBold"
                                     FontSize="13"
                                     TextWrapping="Wrap"
                                     Margin="0,12,0,0" />

                          <TextBlock Grid.Row="3"
                                     Text="{services:Loc AccessLabel}"
                                     Style="{StaticResource LabelTextStyle}"
                                     Margin="0,12,12,0" />
                          <TextBlock Grid.Row="3"
                                     Grid.Column="1"
                                     Text="{Binding AccessPostureLabel}"
                                     Foreground="{DynamicResource TextBrush}"
                                     FontWeight="SemiBold"
                                     FontSize="13"
                                     TextWrapping="Wrap"
                                     Margin="0,12,0,0" />

                          <TextBlock Grid.Row="4"
                                     Text="{services:Loc Ui_Patches}"
                                     Style="{StaticResource LabelTextStyle}"
                                     Margin="0,12,12,0" />
                          <TextBlock Grid.Row="4"
                                     Grid.Column="1"
                                     Text="{Binding CustomPatchesBadge}"
                                     Foreground="{DynamicResource TextBrush}"
                                     FontWeight="SemiBold"
                                     FontSize="13"
                                     TextWrapping="Wrap"
                                     Margin="0,12,0,0" />
                        </Grid>

                        <Border Height="1"
                                Background="{DynamicResource StrokeSoftBrush}"
                                Margin="0,16,0,16" />

                        <TextBlock Text="{services:Loc RunReadinessLabel}"
                                   Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding CustomRunReadinessTitle}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,4,0,6"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CustomRunReadinessDetail}"
                                   Style="{StaticResource CaptionTextStyle}" />

                        <Border Height="1"
                                Background="{DynamicResource StrokeSoftBrush}"
                                Margin="0,16,0,16" />

                        <TextBlock Text="{services:Loc CurrentSelectionsLabel}"
                                   Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding ThemeSummary}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LyricsSummary}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding CacheSummary}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CustomSelectionSummary}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CustomPatchesSummary}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{services:Loc CompatibilityTargetLabel}"
                                   Style="{StaticResource LabelTextStyle}"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="{Binding SpotifyVersionSummary}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SpotifyVersionNotes}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{services:Loc DownloadRouteLabel}"
                                   Style="{StaticResource LabelTextStyle}"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="{Binding DownloadMethodSummary}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DownloadMethodDetail}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,4,0,0" />

                        <Border Height="1"
                                Background="{DynamicResource StrokeSoftBrush}"
                                Margin="0,16,0,16" />

                        <TextBlock Text="{services:Loc WhatToWatchLabel}"
                                   Style="{StaticResource LabelTextStyle}" />
                        <ItemsControl ItemsSource="{Binding SelectionInsights}"
                                      ItemTemplate="{StaticResource SelectionInsightTemplate}"
                                      Margin="0,10,0,0" />

                        <Border Height="1"
                                Background="{DynamicResource StrokeSoftBrush}"
                                Margin="0,6,0,16" />

                        <TextBlock Text="{services:Loc ExtensionsLabel}"
                                   Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding ExtensionSummary}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,6,0,8"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding SelectedExtensionLabels}"
                                      ItemTemplate="{StaticResource SelectionBadgeTemplate}">
                          <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedExtensions}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ItemsControl.Style>
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel Margin="0,0,0,0">
                          <StackPanel.Style>
                            <Style TargetType="StackPanel">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedExtensions}" Value="False">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </StackPanel.Style>
                          <TextBlock Text="{services:Loc NoExtensionsSelected}"
                                     Foreground="{DynamicResource TextBrush}"
                                     FontWeight="SemiBold"
                                     FontSize="13" />
                          <TextBlock Text="{services:Loc NoExtensionsHint}"
                                     Style="{StaticResource CaptionTextStyle}"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                      </StackPanel>
                </Border>
</UserControl>
