<UserControl x:Class="LibreSpot.Desktop.Views.MaintenanceWorkspaceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LibreSpot.Desktop.Controls"
        xmlns:avalon="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
        xmlns:models="clr-namespace:LibreSpot.Desktop.Models;assembly=LibreSpot.Core"
        xmlns:viewModels="clr-namespace:LibreSpot.Desktop.ViewModels"
        xmlns:services="clr-namespace:LibreSpot.Desktop.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
        mc:Ignorable="d"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            AutomationProperties.AutomationId="MaintenanceWorkspace"
                            AutomationProperties.Name="{services:Loc Ui_MaintenanceWorkspace}">
                <StackPanel Margin="0,12,0,0">
                  <TextBlock Text="{Binding MaintenanceGuidanceTitle}"
                             Style="{StaticResource SectionTitleTextStyle}"
                             FontSize="24" />
                  <TextBlock Text="{Binding MaintenanceGuidanceDetail}"
                             Style="{StaticResource CaptionTextStyle}"
                             Foreground="{DynamicResource TextBrush}"
                             Margin="0,8,0,0"
                             MaxWidth="780"
                             HorizontalAlignment="Left"
                             TextAlignment="Left"
                             TextWrapping="Wrap" />

                  <Border Height="1"
                          Background="{DynamicResource StrokeSoftBrush}"
                          Margin="0,18,0,18" />

                  <TextBlock Text="{services:Loc EnvironmentLabel}"
                             Style="{StaticResource SectionEyebrowTextStyle}"
                             Margin="0,0,0,10" />
                  <ItemsControl ItemsSource="{Binding StatusDashboardItems}"
                                ItemTemplate="{StaticResource StatusDashboardItemTemplate}"
                                AutomationProperties.Name="{services:Loc EnvironmentLabel}"
                                Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>

                  <UniformGrid Columns="4"
                               Margin="0,0,0,14">
                    <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,10,0">
                      <StackPanel>
                        <TextBlock Text="{services:Loc StackLabel}"
                                   Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding MaintenanceReadinessValue}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MaintenanceReadinessDetail}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,6,0,0" />
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,10,0">
                      <StackPanel>
                        <TextBlock Text="{services:Loc BackupsLabel}"
                                   Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding MaintenanceBackupValue}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MaintenanceBackupDetail}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,6,0,0" />
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,10,0">
                      <StackPanel>
                        <TextBlock Text="{services:Loc MarketplaceLabel}"
                                   Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding MaintenanceMarketplaceValue}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MaintenanceMarketplaceDetail}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,6,0,0" />
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SubtleCardStyle}">
                      <StackPanel>
                        <TextBlock Text="{services:Loc ThemeLabel}"
                                   Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding MaintenanceThemeValue}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MaintenanceThemeDetail}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,6,0,0" />
                      </StackPanel>
                    </Border>
                  </UniformGrid>

                  <Border x:Name="SupportBundleQaSurface"
                          Style="{StaticResource SubtleCardStyle}"
                          Margin="0,0,0,14"
                          AutomationProperties.AutomationId="SupportBundleQaSurface"
                          AutomationProperties.Name="{services:Loc SupportBundleTitle}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                          <TextBlock Text="{services:Loc SupportBundleTitle}"
                                     Style="{StaticResource SectionTitleTextStyle}"
                                     FontSize="18" />
                          <TextBlock Text="{Binding SupportBundlePreviewTitle}"
                                     Foreground="{DynamicResource TextBrush}"
                                     FontWeight="SemiBold"
                                     Margin="0,8,0,0"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding SupportBundlePreviewDetail}"
                                     Style="{StaticResource CaptionTextStyle}"
                                     Margin="0,4,0,0" />
                          <TextBlock Text="{Binding SupportBundleRedactionSummary}"
                                     Style="{StaticResource CaptionTextStyle}"
                                     Foreground="{DynamicResource TextBrush}"
                                     Margin="0,8,0,0"
                                     TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                MinWidth="170"
                                Height="42"
                                Padding="16,0"
                                Content="{services:Loc ButtonExportBundle}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.AutomationId="SupportBundleExportButton"
                                AutomationProperties.Name="{services:Loc ButtonExportBundleName}"
                                AutomationProperties.HelpText="{services:Loc ButtonExportBundleHint}"
                                Command="{Binding ExportSupportBundleCommand}" />
                      </Grid>

                      <ItemsControl ItemsSource="{Binding SupportBundleItems}"
                                    ItemTemplate="{StaticResource SupportBundleCategoryTemplate}"
                                    Margin="0,16,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>

                      <Border Height="1"
                              Background="{DynamicResource StrokeSoftBrush}"
                              Margin="0,8,0,14" />

                      <ItemsControl ItemsSource="{Binding SupportBundleRedactionRules}"
                                    Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,0,0,6">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Width="4"
                                      Height="14"
                                      CornerRadius="{StaticResource RadiusXs}"
                                      Background="{DynamicResource AccentBrush}"
                                      Margin="0,3,10,0" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding}"
                                         Style="{StaticResource CaptionTextStyle}"
                                         TextWrapping="Wrap" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding SupportBundleLastExportText}"
                                 Style="{StaticResource CaptionTextStyle}"
                                 Foreground="{DynamicResource MutedTextBrush}"
                                 Margin="0,8,0,0"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,14">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{services:Loc AutoReapplyTitle}"
                                     Style="{StaticResource SectionTitleTextStyle}"
                                     FontSize="18" />
                          <TextBlock Text="{Binding AutoReapplyStatusDetail}"
                                     Style="{StaticResource CaptionTextStyle}"
                                     Foreground="{DynamicResource TextBrush}"
                                     Margin="0,8,0,0"
                                     MaxWidth="760"
                                     TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Style="{StaticResource MicroBadgeStyle}"
                                Margin="18,0,0,0">
                          <TextBlock Text="{Binding AutoReapplyStatusTitle}"
                                     Style="{StaticResource MicroBadgeTextStyle}" />
                        </Border>
                      </Grid>

                      <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="4" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                CornerRadius="{StaticResource RadiusXs}">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Snapshot.AutoReapplyTaskRegistered}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                          <TextBlock Text="{Binding AutoReapplyTaskLine}"
                                     Foreground="{DynamicResource TextBrush}"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding AutoReapplyLogLine}"
                                     Style="{StaticResource CaptionTextStyle}"
                                     Foreground="{DynamicResource SubtleTextBrush}"
                                     Margin="0,4,0,0"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>

                      <WrapPanel Grid.Row="2"
                                 Margin="0,18,0,0"
                                 HorizontalAlignment="Right">
                        <Button Content="{services:Loc ButtonEnableWatcher}"
                                MinWidth="136"
                                Height="38"
                                Padding="16,0"
                                Margin="0,0,10,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.Name="{services:Loc ButtonEnableWatcherName}"
                                AutomationProperties.HelpText="{services:Loc ButtonEnableWatcherHint}"
                                Command="{Binding EnableAutoReapplyCommand}" />
                        <Button Content="{services:Loc ButtonDisableWatcher}"
                                MinWidth="136"
                                Height="38"
                                Padding="16,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.Name="{services:Loc ButtonDisableWatcherName}"
                                AutomationProperties.HelpText="{services:Loc ButtonDisableWatcherHint}"
                                Command="{Binding DisableAutoReapplyCommand}" />
                      </WrapPanel>
                    </Grid>
                  </Border>

                  <Border Style="{StaticResource SubtleCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                      <TextBlock Text="{services:Loc RefreshRecoverSection}"
                                 Style="{StaticResource SectionTitleTextStyle}"
                                 FontSize="18" />
                      <TextBlock Text="{services:Loc RefreshRecoverDescription}"
                                 Style="{StaticResource CaptionTextStyle}"
                                 Foreground="{DynamicResource TextBrush}"
                                 Margin="0,8,0,12" />
                      <ItemsControl ItemsSource="{Binding SafeMaintenanceActions}"
                                    ItemTemplate="{StaticResource MaintenanceTemplate}" />
                    </StackPanel>
                  </Border>

                  <Border Style="{StaticResource SubtleCardStyle}"
                          Background="{DynamicResource Surface1Brush}"
                          BorderBrush="{DynamicResource StrokeSoftBrush}">
                    <StackPanel>
                      <TextBlock Text="{services:Loc ResetSection}"
                                 Style="{StaticResource SectionTitleTextStyle}"
                                 FontSize="18"
                                 Foreground="{DynamicResource DangerTextBrush}" />
                      <TextBlock Text="{services:Loc ResetDescription}"
                                 Style="{StaticResource CaptionTextStyle}"
                                 Foreground="{DynamicResource TextBrush}"
                                 Margin="0,8,0,12" />
                      <ItemsControl ItemsSource="{Binding DestructiveMaintenanceActions}"
                                    ItemTemplate="{StaticResource MaintenanceTemplate}" />
                    </StackPanel>
                  </Border>

                  <TextBlock Text="{services:Loc MaintenanceClosingHint}"
                             Style="{StaticResource CaptionTextStyle}"
                             Foreground="{DynamicResource MutedTextBrush}"
                             Margin="0,16,0,0"
                             MaxWidth="760"
                             TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
</UserControl>
