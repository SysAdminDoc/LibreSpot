<UserControl x:Class="LibreSpot.Desktop.Views.RecommendedWorkspaceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:LibreSpot.Desktop.ViewModels"
        xmlns:services="clr-namespace:LibreSpot.Desktop.Services"
        xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
        mc:Ignorable="d"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <UserControl.Resources>
    <DataTemplate x:Key="SimpleReadinessCheckTemplate"
                  DataType="{x:Type viewModels:ShellReadinessCheckItemViewModel}">
      <Border BorderBrush="{DynamicResource StrokeSoftBrush}"
              BorderThickness="0,0,1,0"
              Padding="8,0"
              AutomationProperties.Name="{Binding AutomationText}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid Width="40"
                Height="40"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
            <Ellipse StrokeThickness="2">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="info">
                      <Setter Property="Stroke" Value="{DynamicResource InfoBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="warning">
                      <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="critical">
                      <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <ui:SymbolIcon FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
              <ui:SymbolIcon.Style>
                <Style TargetType="{x:Type ui:SymbolIcon}">
                  <Setter Property="Symbol" Value="Checkmark20" />
                  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="info">
                      <Setter Property="Symbol" Value="Info20" />
                      <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="warning">
                      <Setter Property="Symbol" Value="Info20" />
                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="critical">
                      <Setter Property="Symbol" Value="ShieldError20" />
                      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
          </Grid>

          <StackPanel Grid.Column="1"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center">
            <TextBlock Text="{Binding Label}"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Status}"
                       Margin="0,3,0,0"
                       FontSize="14">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="info">
                      <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="warning">
                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="critical">
                      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ShellEnvironmentRowTemplate"
                  DataType="{x:Type viewModels:ShellEnvironmentRowViewModel}">
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon Symbol="ShieldCheckmark20"
                       FontSize="19"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding Label}"
                   Foreground="{DynamicResource TextBrush}"
                   FontWeight="SemiBold"
                   FontSize="13"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   Text="{Binding Value}"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="13"
                   TextAlignment="Right"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   Margin="14,0,0,0" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ShellDependencyRowTemplate"
                  DataType="{x:Type viewModels:ShellDependencyRowViewModel}">
      <Grid MinHeight="38" Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon FontSize="18"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left">
          <ui:SymbolIcon.Style>
            <Style TargetType="{x:Type ui:SymbolIcon}">
              <Setter Property="Symbol" Value="Info20" />
              <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ready">
                  <Setter Property="Symbol" Value="Checkmark20" />
                  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warning">
                  <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="critical">
                  <Setter Property="Symbol" Value="ShieldError20" />
                  <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:SymbolIcon.Style>
        </ui:SymbolIcon>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Component}"
                     Foreground="{DynamicResource TextBrush}"
                     FontWeight="SemiBold"
                     FontSize="13" />
          <TextBlock Text="{Binding Detail}"
                     Foreground="{DynamicResource MutedTextBrush}"
                     FontSize="13"
                     Margin="0,2,0,0"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <Style x:Key="SimpleDetailsExpanderStyle" TargetType="Expander">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Grid Height="42">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Height="1"
                        Background="{DynamicResource StrokeSoftBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,24,0" />
                <ToggleButton x:Name="HeaderButton"
                              Grid.Column="1"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="0"
                              Cursor="Hand"
                              FocusVisualStyle="{x:Null}"
                              AutomationProperties.Name="{TemplateBinding Header}"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{TemplateBinding Header}"
                               Foreground="{DynamicResource InfoBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <ui:SymbolIcon x:Name="DetailsChevron"
                                   Symbol="ChevronDown20"
                                   FontSize="18"
                                   Foreground="{DynamicResource InfoBrush}"
                                   Margin="8,0,0,0"
                                   RenderTransformOrigin="0.5,0.5">
                      <ui:SymbolIcon.RenderTransform>
                        <RotateTransform Angle="0" />
                      </ui:SymbolIcon.RenderTransform>
                    </ui:SymbolIcon>
                  </StackPanel>
                </ToggleButton>
                <Border Grid.Column="2"
                        Height="1"
                        Background="{DynamicResource StrokeSoftBrush}"
                        VerticalAlignment="Center"
                        Margin="24,0,0,0" />
              </Grid>

              <ContentPresenter x:Name="ExpandSite"
                                Grid.Row="1"
                                ContentSource="Content"
                                Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                <Setter TargetName="DetailsChevron" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="180" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger SourceName="HeaderButton" Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="HeaderButton" Property="BorderBrush" Value="{DynamicResource AccentRingBrush}" />
                <Setter TargetName="HeaderButton" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <Grid MaxWidth="920"
          HorizontalAlignment="Stretch"
          Margin="0,24,0,28"
          AutomationProperties.AutomationId="RecommendedWorkspace"
          AutomationProperties.Name="{services:Loc Ui_RecommendedWorkspace}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Width="184"
            Height="184"
            HorizontalAlignment="Center">
        <Ellipse StrokeThickness="4"
                 Fill="{DynamicResource AccentSoftBrush}"
                 Effect="{StaticResource AccentGlow}">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSnapshotLoading}" Value="True">
                  <Setter Property="Stroke" Value="{DynamicResource InfoBrush}" />
                  <Setter Property="Effect" Value="{x:Null}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSnapshotLoadError}" Value="True">
                  <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
                  <Setter Property="Effect" Value="{x:Null}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasCriticalHealthIssues}" Value="True">
                  <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
                  <Setter Property="Effect" Value="{x:Null}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <ui:SymbolIcon FontSize="78"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
          <ui:SymbolIcon.Style>
            <Style TargetType="{x:Type ui:SymbolIcon}">
              <Setter Property="Symbol" Value="Checkmark48" />
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSnapshotLoading}" Value="True">
                  <Setter Property="Symbol" Value="Clock48" />
                  <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSnapshotLoadError}" Value="True">
                  <Setter Property="Symbol" Value="Info48" />
                  <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasCriticalHealthIssues}" Value="True">
                  <Setter Property="Symbol" Value="ShieldError48" />
                  <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:SymbolIcon.Style>
        </ui:SymbolIcon>
      </Grid>

      <TextBlock Grid.Row="1"
                 Text="{Binding SimpleHomeTitle}"
                 FontFamily="{StaticResource HeadingFont}"
                 FontSize="46"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Margin="0,38,0,0" />

      <TextBlock Grid.Row="2"
                 Text="{Binding SimpleHomeBody}"
                 FontSize="17"
                 Foreground="{DynamicResource MutedTextBrush}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 MaxWidth="720"
                 Margin="0,10,0,0" />

      <ItemsControl Grid.Row="3"
                    MaxWidth="820"
                    ItemsSource="{Binding SimpleHomeReadinessChecks}"
                    ItemTemplate="{StaticResource SimpleReadinessCheckTemplate}"
                    Margin="0,66,0,0"
                    HorizontalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <Button Grid.Row="4"
              Width="506"
              Height="80"
              Margin="0,76,0,0"
              Padding="22,0"
              HorizontalAlignment="Center"
              Style="{StaticResource PrimaryButtonStyle}"
              AutomationProperties.AutomationId="RunRecommendedSetupButton"
              AutomationProperties.Name="{services:Loc ButtonStartRecommendedSetup}"
              AutomationProperties.HelpText="{services:Loc Ui_RunsLibreSpotSMostReliableInstallPathWith}"
              Command="{Binding ApplyRecommendedCommand}">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <ui:SymbolIcon Symbol="Play24"
                         FontSize="25"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          <TextBlock Text="{services:Loc ButtonStartRecommendedSetup}"
                     FontSize="19"
                     FontWeight="SemiBold"
                     Margin="14,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <StackPanel Grid.Row="5"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Margin="0,24,0,0">
        <ui:SymbolIcon Symbol="Clock20"
                       FontSize="20"
                       Foreground="{DynamicResource MutedTextBrush}" />
        <TextBlock Text="{services:Loc Vm_SimpleHomeDuration}"
                   FontSize="15"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center" />
      </StackPanel>

      <Expander Grid.Row="6"
                Header="{services:Loc Vm_SimpleHomeDetails}"
                MaxWidth="820"
                HorizontalAlignment="Stretch"
                Margin="0,34,0,0"
                Style="{StaticResource SimpleDetailsExpanderStyle}"
                AutomationProperties.AutomationId="RecommendedDetailsExpander"
                AutomationProperties.Name="{services:Loc Vm_SimpleHomeDetails}">
        <StackPanel Margin="0,22,0,0">
          <Border Style="{StaticResource SubtleCardStyle}"
                  Background="{DynamicResource Surface1Brush}"
                  Padding="18"
                  Margin="0,0,0,12"
                  AutomationProperties.AutomationId="RecommendedFirstRunNarrative"
                  AutomationProperties.Name="{services:Loc Ui_RecommendedFirstRunChecklist}">
            <StackPanel>
              <TextBlock Text="{services:Loc Vm_RecommendedFirstRunTitle}"
                         Style="{StaticResource SectionTitleTextStyle}"
                         FontSize="16" />
              <TextBlock Text="{services:Loc Vm_RecommendedFirstRunIntro}"
                         Style="{StaticResource CaptionTextStyle}"
                         Foreground="{DynamicResource MutedTextBrush}"
                         Margin="0,6,0,0"
                         TextWrapping="Wrap" />
              <TextBlock Text="{services:Loc Vm_RecommendedFirstRunInstall}"
                         Style="{StaticResource BodyTextStyle}"
                         Margin="0,14,0,0"
                         TextWrapping="Wrap" />
              <TextBlock Text="{services:Loc Vm_RecommendedFirstRunUpdates}"
                         Style="{StaticResource BodyTextStyle}"
                         Margin="0,8,0,0"
                         TextWrapping="Wrap" />
              <TextBlock Text="{services:Loc Vm_RecommendedFirstRunReversible}"
                         Style="{StaticResource BodyTextStyle}"
                         Margin="0,8,0,0"
                         TextWrapping="Wrap" />
              <TextBlock Text="{services:Loc Vm_RecommendedFirstRunRisk}"
                         Style="{StaticResource BodyTextStyle}"
                         Margin="0,8,0,0"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding RecommendedFollowUpText}"
                         Style="{StaticResource CaptionTextStyle}"
                         Foreground="{DynamicResource MutedTextBrush}"
                         Margin="0,14,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SubtleCardStyle}"
                  Background="{DynamicResource Surface2Brush}"
                  Padding="18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="1.1*" />
              </Grid.ColumnDefinitions>

              <StackPanel Margin="0,0,18,0">
                <TextBlock Text="{Binding ShellLocalEnvironmentTitle}"
                           Style="{StaticResource SectionTitleTextStyle}"
                           FontSize="16" />
                <Border Height="1"
                        Background="{DynamicResource StrokeSoftBrush}"
                        Margin="0,10,0,14" />
                <ItemsControl ItemsSource="{Binding ShellEnvironmentRows}"
                              ItemTemplate="{StaticResource ShellEnvironmentRowTemplate}" />
              </StackPanel>

              <Border Grid.Column="1"
                      Background="{DynamicResource StrokeSoftBrush}"
                      Margin="0,0,18,0" />

              <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding ShellDependenciesTitle}"
                           Style="{StaticResource SectionTitleTextStyle}"
                           FontSize="16" />
                <Border Height="1"
                        Background="{DynamicResource StrokeSoftBrush}"
                        Margin="0,10,0,14" />
                <ItemsControl ItemsSource="{Binding ShellDependencyRows}"
                              ItemTemplate="{StaticResource ShellDependencyRowTemplate}" />
                <TextBlock Text="{Binding ShellDependenciesSummaryText}"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,8,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Expander>
    </Grid>
  </ScrollViewer>
</UserControl>
