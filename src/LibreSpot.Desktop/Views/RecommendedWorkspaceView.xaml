<UserControl x:Class="LibreSpot.Desktop.Views.RecommendedWorkspaceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LibreSpot.Desktop.Controls"
        xmlns:avalon="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
        xmlns:models="clr-namespace:LibreSpot.Desktop.Models;assembly=LibreSpot.Core"
        xmlns:viewModels="clr-namespace:LibreSpot.Desktop.ViewModels"
        xmlns:services="clr-namespace:LibreSpot.Desktop.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
        mc:Ignorable="d"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <ContentControl Focusable="True"
                                AutomationProperties.AutomationId="RecommendedWorkspace"
                                AutomationProperties.Name="{services:Loc Ui_RecommendedWorkspace}">
                <StackPanel>
                <Border Style="{StaticResource SubtleCardStyle}"
                        Background="{DynamicResource Surface1Brush}"
                        Padding="18"
                        Margin="0,0,0,12"
                        AutomationProperties.AutomationId="RecommendedFirstRunNarrative"
                        AutomationProperties.Name="{services:Loc Ui_RecommendedFirstRunChecklist}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{services:Loc Vm_RecommendedFirstRunTitle}"
                               Style="{StaticResource SectionTitleTextStyle}"
                               FontSize="16" />
                    <TextBlock Grid.Row="1"
                               Text="{services:Loc Vm_RecommendedFirstRunIntro}"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />

                    <StackPanel Grid.Row="2"
                                Margin="0,14,0,0">
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{DynamicResource AccentBrush}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="0,7,0,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{services:Loc Vm_RecommendedFirstRunInstall}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />
                      </Grid>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{DynamicResource AccentBrush}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="0,7,0,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{services:Loc Vm_RecommendedFirstRunUpdates}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />
                      </Grid>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{DynamicResource AccentBrush}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="0,7,0,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{services:Loc Vm_RecommendedFirstRunReversible}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />
                      </Grid>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{DynamicResource AccentBrush}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="0,7,0,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{services:Loc Vm_RecommendedFirstRunRisk}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />
                      </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Margin="0,14,0,0">
                      <TextBlock Text="{Binding RecommendedRunDuration}"
                                 Style="{StaticResource CaptionTextStyle}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding RecommendedFollowUpText}"
                                 Style="{StaticResource CaptionTextStyle}"
                                 Foreground="{DynamicResource MutedTextBrush}"
                                 Margin="0,4,0,0"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Style="{StaticResource SubtleCardStyle}"
                        Background="{DynamicResource Surface2Brush}"
                        Padding="18"
                        Margin="0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="0.9*" />
                      <ColumnDefinition Width="1" />
                      <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,18,0">
                      <TextBlock Text="{Binding ShellLocalEnvironmentTitle}"
                                 Style="{StaticResource SectionTitleTextStyle}"
                                 FontSize="16" />
                      <Border Height="1"
                              Background="{DynamicResource StrokeSoftBrush}"
                              Margin="0,10,0,14" />
                      <ItemsControl ItemsSource="{Binding ShellEnvironmentRows}"
                                    ItemTemplate="{StaticResource ShellEnvironmentRowTemplate}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource StrokeSoftBrush}"
                            Margin="0,0,18,0" />

                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{Binding ShellDependenciesTitle}"
                                 Style="{StaticResource SectionTitleTextStyle}"
                                 FontSize="16" />
                      <Border Height="1"
                              Background="{DynamicResource StrokeSoftBrush}"
                              Margin="0,10,0,14" />
                      <ItemsControl ItemsSource="{Binding ShellDependencyRows}"
                                    ItemTemplate="{StaticResource ShellDependencyRowTemplate}" />
                      <TextBlock Text="{Binding ShellDependenciesSummaryText}"
                                 Style="{StaticResource CaptionTextStyle}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Margin="0,8,0,0" />
                    </StackPanel>
                  </Grid>
                </Border>
                </StackPanel>
                </ContentControl>
              </ScrollViewer>
</UserControl>
