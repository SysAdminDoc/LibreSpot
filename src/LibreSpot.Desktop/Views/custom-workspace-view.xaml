                                Background="{DynamicResource StrokeSoftBrush}"
                                Margin="0,16,0,16" />

                        <TextBlock Text="{services:Loc WhatToWatchLabel}"
                                   Style="{StaticResource LabelTextStyle}" />
                        <ItemsControl ItemsSource="{Binding SelectionInsights}"
                                      ItemTemplate="{StaticResource SelectionInsightTemplate}"
                                      Margin="0,10,0,0" />

                        <Border Height="1"
                                Background="{DynamicResource StrokeSoftBrush}"
                                Margin="0,6,0,16" />

                        <TextBlock Text="{services:Loc ExtensionsLabel}"
                                   Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding ExtensionSummary}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,6,0,8"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding SelectedExtensionLabels}"
                                      ItemTemplate="{StaticResource SelectionBadgeTemplate}">
                          <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedExtensions}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ItemsControl.Style>
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel Margin="0,0,0,0">
                          <StackPanel.Style>
                            <Style TargetType="StackPanel">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedExtensions}" Value="False">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </StackPanel.Style>
                          <TextBlock Text="{services:Loc NoExtensionsSelected}"
                                     Foreground="{DynamicResource TextBrush}"
                                     FontWeight="SemiBold"
                                     FontSize="13" />
                          <TextBlock Text="{services:Loc NoExtensionsHint}"
                                     Style="{StaticResource CaptionTextStyle}"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                      </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="1"
                            Content="{services:Loc ButtonApplyCustomProfile}"
                            Height="48"
                            Margin="0,16,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.AutomationId="ApplyCustomProfileButton"
                            AutomationProperties.Name="{services:Loc ButtonApplyCustomProfile}"
                            AutomationProperties.HelpText="{services:Loc ButtonApplyCustomProfileHint}"
                            Command="{Binding ApplyCustomCommand}" />
                    <TextBlock Grid.Row="2"
                               Text="{Binding CustomApplyCaption}"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,10,0,0"
                               TextAlignment="Center" />
                  </Grid>
                </Border>
              </Grid>
</UserControl>
