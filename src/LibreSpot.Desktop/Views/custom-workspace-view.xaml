<UserControl x:Class="LibreSpot.Desktop.Views.CustomWorkspaceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LibreSpot.Desktop.Controls"
        xmlns:avalon="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
        xmlns:models="clr-namespace:LibreSpot.Desktop.Models;assembly=LibreSpot.Core"
        xmlns:viewModels="clr-namespace:LibreSpot.Desktop.ViewModels"
        xmlns:services="clr-namespace:LibreSpot.Desktop.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
        mc:Ignorable="d"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
              <Grid AutomationProperties.AutomationId="CustomWorkspace"
                    AutomationProperties.Name="{services:Loc Ui_CustomWorkspace}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                               VerticalScrollBarVisibility="Auto"
                               HorizontalScrollBarVisibility="Disabled"
                               AutomationProperties.AutomationId="CustomSettingsEditor"
                               AutomationProperties.Name="{services:Loc Ui_CustomSettingsEditor}"
                               Margin="0,0,22,0">
                  <StackPanel>
                    <TextBlock Text="{services:Loc SearchPlaceholder}"
                               Style="{StaticResource LabelTextStyle}" />
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Text="{Binding SettingsSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Style="{StaticResource TextBoxStylePremium}"
                               Height="42"
                               AutomationProperties.AutomationId="SettingsSearchBox"
                               AutomationProperties.Name="{services:Loc SearchPlaceholder}"
                               AutomationProperties.HelpText="{services:Loc SearchHelpText}" />
                      <Button Grid.Column="1"
                              Content="{services:Loc ButtonClearSearch}"
                              Height="42"
                              MinWidth="84"
                              Margin="10,0,0,0"
                              Padding="18,0"
                              Style="{StaticResource SecondaryButtonStyle}"
                              Visibility="{Binding HasSettingsSearchText, Converter={StaticResource BoolToVisibilityConverter}}"
                              Command="{Binding ClearSettingsSearchCommand}"
                              AutomationProperties.AutomationId="SettingsSearchClearButton"
                              AutomationProperties.Name="{services:Loc ButtonClearSearchName}" />
                    </Grid>
                    <TextBlock Text="{Binding CustomSearchSummary}"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,10,0,18"
                               MaxWidth="760"
                               TextWrapping="Wrap" />

                    <Border Style="{StaticResource SubtleCardStyle}"
                            Background="{DynamicResource Surface1Brush}"
                            Margin="0,0,0,18"
                            Visibility="{Binding ShowCustomSearchEmptyState, Converter={StaticResource BoolToVisibilityConverter}}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="4"
                                Height="38"
                                CornerRadius="{StaticResource RadiusXs}"
                                Background="{DynamicResource StrokeStrongBrush}"
                                Margin="0,2,12,0"
                                VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{services:Loc SearchNoResults}"
                                     Style="{StaticResource EmptyStateTitleTextStyle}" />
                          <TextBlock Text="{services:Loc SearchNoResultsHint}"
                                     Style="{StaticResource EmptyStateBodyTextStyle}"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                      </Grid>
                    </Border>

                    <Border Style="{StaticResource MinimalSectionStyle}"
                            Visibility="{Binding HasVisibleInstallOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                      <StackPanel>
                        <TextBlock Text="{services:Loc InstallPostureSection}" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{services:Loc InstallPostureDescription}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,6,0,14" />
                        <ItemsControl ItemsSource="{Binding InstallOptions}" ItemTemplate="{StaticResource OptionTemplate}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MinimalSectionStyle}"
                            Visibility="{Binding HasVisibleAppearanceSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="1.15*" />
                          <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,20,0">
                          <TextBlock Text="{services:Loc AppearanceSection}" Style="{StaticResource SectionTitleTextStyle}" />
                          <TextBlock Text="{services:Loc AppearanceDescription}"
                                     Style="{StaticResource BodyTextStyle}"
                                     Margin="0,6,0,16" />

                          <TextBlock Text="{services:Loc ThemePackLabel}" Style="{StaticResource LabelTextStyle}" />
                          <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ThemeSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStylePremium}"
                                     Height="42"
                                     AutomationProperties.Name="{services:Loc ThemeGallerySearchName}"
                                     AutomationProperties.HelpText="{services:Loc ThemeGallerySearchHint}" />
                            <Button Grid.Column="1"
                                    Content="{services:Loc ButtonClearSearch}"
                                    Height="42"
                                    MinWidth="84"
                                    Margin="10,0,0,0"
                                    Padding="18,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Visibility="{Binding HasThemeSearchText, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Command="{Binding ClearThemeSearchCommand}"
                                    AutomationProperties.Name="{services:Loc ButtonClearSearchName}" />
                          </Grid>

                          <ListBox ItemsSource="{Binding FilteredThemeGalleryItems}"
                                   SelectedItem="{Binding SelectedThemeGalleryItem, Mode=TwoWay}"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   Padding="0"
                                   MaxHeight="340"
                                   PreviewMouseWheel="NestedScrollRegion_OnPreviewMouseWheel"
                                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                                   KeyboardNavigation.DirectionalNavigation="Contained"
                                   AutomationProperties.Name="{services:Loc ThemePackLabel}"
                                   AutomationProperties.HelpText="{services:Loc ThemePackHint}"
                                   Margin="0,0,0,14">
                            <ListBox.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                              <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListBoxItemStyle}">
                                <Setter Property="Margin" Value="0,0,10,10" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <!-- Constant thickness: the keyboard focus ring swaps brush
                                     only, so focus never shifts layout. -->
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding AutomationHelpText}" />
                                <Style.Triggers>
                                  <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentRingBrush}" />
                                  </Trigger>
                                </Style.Triggers>
                              </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                              <DataTemplate>
                                <Border Width="246"
                                        MinHeight="152"
                                        Padding="12"
                                        Background="{DynamicResource Surface1Brush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                  <Border.Style>
                                    <Style TargetType="Border">
                                      <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}" />
                                      <Style.Triggers>
                                        <!-- Hover affordance; selection accent overrides it. -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                          <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
                                          <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Border.Style>
                                  <StackPanel>
                                    <Grid Height="46" ClipToBounds="True">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                      </Grid.ColumnDefinitions>
                                      <Border Grid.Column="0" Background="{Binding SwatchA}" CornerRadius="6,0,0,6" />
                                      <Border Grid.Column="1" Background="{Binding SwatchB}" />
                                      <Border Grid.Column="2" Background="{Binding SwatchC}" CornerRadius="0,6,6,0" />
                                    </Grid>
                                    <StackPanel Margin="0,10,0,0">
                                      <TextBlock Text="{Binding Label}"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 FontWeight="SemiBold"
                                                 TextWrapping="Wrap" />
                                      <Border Style="{StaticResource MicroBadgeStyle}"
                                              HorizontalAlignment="Left"
                                              Margin="0,7,0,0">
                                        <TextBlock Text="{Binding SourceBadge}"
                                                   Style="{StaticResource MicroBadgeTextStyle}" />
                                      </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SchemeCountText}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding SchemePreview}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               MaxHeight="36"
                                               Margin="0,4,0,0" />
                                    <Border Style="{StaticResource MicroBadgeStyle}"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Visibility="{Binding HasJsBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                      <TextBlock Text="{Binding JsBadge}"
                                                 Style="{StaticResource MicroBadgeTextStyle}" />
                                    </Border>
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>

                          <TextBlock Text="{Binding ThemeGalleryEmptyText}"
                                     Style="{StaticResource CaptionTextStyle}"
                                     Foreground="{DynamicResource WarningBrush}"
                                     Visibility="{Binding ShowThemeGalleryEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Margin="0,0,0,14" />

                          <TextBlock Text="{services:Loc ColorSchemeLabel}" Style="{StaticResource LabelTextStyle}" />
                          <ListBox ItemsSource="{Binding SchemeOptions}"
                                   SelectedItem="{Binding SelectedScheme, Mode=TwoWay}"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   Padding="0"
                                   IsEnabled="{Binding IsThemeSchemeAvailable}"
                                   PreviewMouseWheel="NestedScrollRegion_OnPreviewMouseWheel"
                                   AutomationProperties.Name="{services:Loc ColorSchemeLabel}"
                                   AutomationProperties.HelpText="{Binding ThemeSchemeHint}"
                                   Margin="0,6,0,6">
                            <ListBox.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                              <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListBoxItemStyle}">
                                <Setter Property="Margin" Value="0,0,8,8" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Converter={StaticResource PrettifyConverter}}" />
                                <Style.Triggers>
                                  <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentRingBrush}" />
                                  </Trigger>
                                </Style.Triggers>
                              </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                              <DataTemplate>
                                <Border MinWidth="76"
                                        Height="32"
                                        Padding="12,0"
                                        Background="{DynamicResource Surface1Brush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                  <Border.Style>
                                    <Style TargetType="Border">
                                      <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}" />
                                      <Style.Triggers>
                                        <!-- Hover affordance; selection accent overrides it. -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                          <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
                                          <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Border.Style>
                                  <TextBlock Text="{Binding Converter={StaticResource PrettifyConverter}}"
                                             VerticalAlignment="Center"
                                             TextAlignment="Center"
                                             Foreground="{DynamicResource TextBrush}"
                                             FontSize="12" />
                                </Border>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                          <TextBlock Text="{Binding ThemeSchemeHint}"
                                     Style="{StaticResource CaptionTextStyle}"
                                     Margin="0,0,0,14" />

                          <TextBlock Text="{services:Loc LyricsThemeLabel}" Style="{StaticResource LabelTextStyle}" />
                          <ComboBox ItemsSource="{Binding LyricsThemes}"
                                     SelectedItem="{Binding SelectedLyricsTheme, Mode=TwoWay}"
                                     Style="{StaticResource ComboBoxStylePremium}"
                                     IsEnabled="{Binding IsLyricsThemeAvailable}"
                                     AutomationProperties.Name="{services:Loc LyricsThemeLabel}"
                                     AutomationProperties.HelpText="{Binding LyricsThemeHint}"
                                     Margin="0,6,0,6">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource PrettifyConverter}}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <TextBlock Text="{Binding LyricsThemeHint}"
                                     Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{services:Loc CacheLimitLabel}" Style="{StaticResource LabelTextStyle}" />
                          <Grid Margin="0,6,0,8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CacheLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBoxStylePremium}"
                                     MaxLength="6"
                                     AutomationProperties.Name="{services:Loc CacheLimitName}"
                                     AutomationProperties.HelpText="{services:Loc CacheLimitHint}"
                                     DataObject.Pasting="CacheLimitTextBox_OnPasting"
                                     PreviewTextInput="CacheLimitTextBox_OnPreviewTextInput" />
                            <TextBlock Grid.Column="1"
                                       Text="{services:Loc CacheLimitUnit}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                          </Grid>
                          <TextBlock Text="{services:Loc CacheLimitDefault}"
                                     Style="{StaticResource CaptionTextStyle}" />

                          <Border Height="1"
                                  Background="{DynamicResource StrokeSoftBrush}"
                                  Margin="0,16,0,16" />

                          <TextBlock Text="{services:Loc CompatibilityTargetLabel}"
                                     Style="{StaticResource LabelTextStyle}" />
                          <TextBlock Text="{services:Loc SpotifyBuildLabel}"
                                     Style="{StaticResource SectionTitleTextStyle}"
                                     FontSize="16"
                                     Margin="0,6,0,0" />
                          <ComboBox ItemsSource="{Binding SpotifyVersionOptions}"
                                     SelectedValue="{Binding SelectedSpotifyVersionId, Mode=TwoWay}"
                                     SelectedValuePath="Id"
                                     Style="{StaticResource ComboBoxStylePremium}"
                                     AutomationProperties.Name="{services:Loc SpotifyCompatibilityName}"
                                     AutomationProperties.HelpText="{services:Loc SpotifyCompatibilityHint}"
                                     Margin="0,10,0,6">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <TextBlock Text="{Binding SpotifyVersionNotes}"
                                     Style="{StaticResource CaptionTextStyle}" />

                          <TextBlock Text="{services:Loc DownloadPathLabel}"
                                     Style="{StaticResource LabelTextStyle}"
                                     Margin="0,16,0,0" />
                          <ComboBox ItemsSource="{Binding DownloadMethodOptions}"
                                     SelectedValue="{Binding SelectedDownloadMethod, Mode=TwoWay}"
                                     SelectedValuePath="Id"
                                     Style="{StaticResource ComboBoxStylePremium}"
                                     AutomationProperties.Name="{services:Loc DownloadMethodName}"
                                     AutomationProperties.HelpText="{services:Loc DownloadMethodHint}"
                                     Margin="0,10,0,6">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <TextBlock Text="{Binding DownloadMethodDetail}"
                                     Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                      </Grid>
                    </Border>

                    <Border Style="{StaticResource MinimalSectionStyle}"
                            Visibility="{Binding HasVisibleBehaviorSection, Converter={StaticResource BoolToVisibilityConverter}}">
                      <StackPanel>
                        <TextBlock Text="{services:Loc PlaybackBehaviorSection}" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{services:Loc PlaybackBehaviorDescription}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,6,0,14" />

                        <TextBlock Text="{services:Loc CoreBehaviorLabel}"
                                   Style="{StaticResource LabelTextStyle}"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding HasVisibleCoreOptions, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding CoreOptions}" ItemTemplate="{StaticResource OptionTemplate}">
                          <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasVisibleCoreOptions}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ItemsControl.Style>
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Height="1"
                                Background="{DynamicResource StrokeSoftBrush}"
                                Margin="0,8,0,14">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasVisibleCoreOptions}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasVisibleInterfaceOptions}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                        </Border>

                        <TextBlock Text="{services:Loc InterfaceTuningLabel}"
                                   Style="{StaticResource LabelTextStyle}"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding HasVisibleInterfaceOptions, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding InterfaceOptions}" ItemTemplate="{StaticResource OptionTemplate}">
                          <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasVisibleInterfaceOptions}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ItemsControl.Style>
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MinimalSectionStyle}"
                            Visibility="{Binding HasVisibleAdvancedSection, Converter={StaticResource BoolToVisibilityConverter}}">
                      <StackPanel>
                        <TextBlock Text="{services:Loc AdvancedAdjustmentsSection}" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{services:Loc AdvancedAdjustmentsHint}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,6,0,14" />
                        <ItemsControl ItemsSource="{Binding AdvancedOptions}" ItemTemplate="{StaticResource OptionTemplate}">
                          <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasVisibleAdvancedOptions}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ItemsControl.Style>
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Border Height="1"
                                Background="{DynamicResource StrokeSoftBrush}"
                                Margin="0,8,0,14">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasVisibleAdvancedOptions}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasVisibleExperienceOptions}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                        </Border>

                        <TextBlock Text="{services:Loc ExperienceExtrasLabel}"
                                   Style="{StaticResource LabelTextStyle}"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding HasVisibleExperienceOptions, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding ExperienceOptions}" ItemTemplate="{StaticResource OptionTemplate}">
                          <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasVisibleExperienceOptions}" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ItemsControl.Style>
                        </ItemsControl>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MinimalSectionStyle}"
                            Visibility="{Binding HasVisibleCustomPatchesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                      <StackPanel>
                        <DockPanel LastChildFill="True">
                          <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{services:Loc Ui_CustomPatches}"
                                       Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="{services:Loc Ui_AuthorAndDryRunASpotXPatchesJson}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,6,0,0" />
                          </StackPanel>
                          <Border Style="{StaticResource MicroBadgeStyle}"
                                  DockPanel.Dock="Right"
                                  Margin="12,2,0,0"
                                  VerticalAlignment="Top">
                            <TextBlock Text="{Binding CustomPatchesBadge}"
                                       Style="{StaticResource MicroBadgeTextStyle}" />
                          </Border>
                        </DockPanel>

                        <CheckBox Content="{services:Loc Ui_StageCustomPatchesDuringInstallAndReapply}"
                                  IsChecked="{Binding CustomPatchesEnabled, Mode=TwoWay}"
                                  Style="{StaticResource SettingCheckBoxStyle}"
                                  Margin="0,14,0,10"
                                  AutomationProperties.Name="{services:Loc Ui_StageCustomSpotXPatches}"
                                  AutomationProperties.HelpText="{services:Loc Ui_WhenEnabledLibreSpotValidatesThisJSONAndWrites}" />

                        <Grid Margin="0,2,0,10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBox Text="{Binding CustomPatchesImportUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Style="{StaticResource TextBoxStylePremium}"
                                   MinHeight="40"
                                   ToolTip="{services:Loc Ui_HTTPSURLToASpotXPatchesJsonFile}"
                                   AutomationProperties.Name="{services:Loc Ui_CustomPatchesImportURL}"
                                   AutomationProperties.HelpText="{services:Loc Ui_EnterAnHTTPSURLThenImportTheJSON}" />
                          <Button Grid.Column="1"
                                  Content="{services:Loc Ui_ImportURL}"
                                  Command="{Binding ImportCustomPatchesFromUrlCommand}"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Margin="10,0,0,0"
                                  MinWidth="112"
                                  AutomationProperties.Name="{services:Loc Ui_ImportCustomPatchesFromURL}" />
                        </Grid>

                        <Border Background="{DynamicResource Surface3Brush}"
                                BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                MinHeight="220">
                          <avalon:TextEditor x:Name="CustomPatchesTextEditor"
                                             ShowLineNumbers="True"
                                             SyntaxHighlighting="JavaScript"
                                             WordWrap="True"
                                             FontFamily="Cascadia Mono, Consolas"
                                             FontSize="13"
                                             Background="{DynamicResource Surface3Brush}"
                                             Foreground="{DynamicResource TextBrush}"
                                             LineNumbersForeground="{DynamicResource MutedTextBrush}"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             PreviewMouseWheel="NestedScrollRegion_OnPreviewMouseWheel"
                                             TextChanged="CustomPatchesTextEditor_OnTextChanged"
                                             AutomationProperties.Name="{services:Loc Ui_SpotXCustomPatchesJSONEditor}"
                                             AutomationProperties.HelpText="{services:Loc Ui_PasteOrEditSpotXPatchesJsonContentHere}" />
                        </Border>

                        <UniformGrid Columns="4"
                                     Margin="0,12,0,8">
                          <Button Content="{services:Loc Ui_DryRun}"
                                  Command="{Binding ValidateCustomPatchesCommand}"
                                  Style="{StaticResource PrimaryButtonStyle}"
                                  Margin="0,0,6,0"
                                  AutomationProperties.Name="{services:Loc Ui_ValidateCustomPatches}" />
                          <Button Content="{services:Loc Ui_FormatJSON}"
                                  Command="{Binding FormatCustomPatchesCommand}"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Margin="3,0,3,0"
                                  AutomationProperties.Name="{services:Loc Ui_FormatCustomPatchesJSON}" />
                          <Button Content="{services:Loc ButtonClearSearch}"
                                  Command="{Binding ClearCustomPatchesCommand}"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Margin="3,0,3,0"
