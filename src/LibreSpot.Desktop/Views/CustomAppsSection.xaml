<UserControl x:Class="LibreSpot.Desktop.Views.CustomAppsSection"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:services="clr-namespace:LibreSpot.Desktop.Services"
 mc:Ignorable="d"
 UseLayoutRounding="True"
 SnapsToDevicePixels="True">
                    <Border Style="{StaticResource MinimalSectionStyle}"
                            BorderThickness="0"
                            Visibility="{Binding HasVisibleCustomApps, Converter={StaticResource BoolToVisibilityConverter}}">
                      <StackPanel>
                        <TextBlock Text="{Binding CustomAppsSectionDescription}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,0,0,14" />
                        <ItemsControl ItemsSource="{Binding CustomApps}" ItemTemplate="{StaticResource ExtensionTemplate}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
</UserControl>

